{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "paths": {
      "@explainer/*": ["./*"],
      "@project": ["./explainer/index.ts"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts", "explainer"],
  "exclude": ["node_modules", "build", "explainer/demo"]
}
