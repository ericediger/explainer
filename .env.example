# Narration provider. Leave unset to auto-pick: elevenlabs if its key is present,
# else openai if its key is present, else the built-in macOS `say` voice.
# TTS_PROVIDER=say | elevenlabs | openai

# ELEVENLABS_API_KEY=
# Default voice: G3qIj1Lb0GkRqMWsPD2C, the author's, shared in the ElevenLabs Voice Library. Set yours here.
# ELEVENLABS_VOICE_ID=G3qIj1Lb0GkRqMWsPD2C

# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=onyx

# Optional: word-level alignment of your own recordings (<app>/explainer/voice/<scene>.wav).
# ASSEMBLYAI_API_KEY=
